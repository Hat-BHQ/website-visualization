# Core infrastructure
POSTGRES_DB=postgres
POSTGRES_USER=hq_portal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
TZ=Asia/Bangkok

# Per-service database URLs
AUTH_DATABASE_URL=postgresql+psycopg://hq_portal:change-me@postgres:5432/auth_db
HQA_DATABASE_URL=postgresql+psycopg://hq_portal:change-me@postgres:5432/hqa_db
HQS_DATABASE_URL=postgresql+psycopg://hq_portal:change-me@postgres:5432/hqs_db
AUTH_SERVICE_URL=http://auth-service:8000

# JWT
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Seed credentials
SEED_DEFAULT_PASSWORD=ChangeMe123!

# Service ports
AUTH_SERVICE_PORT=8001
HQA_SERVICE_PORT=8002
HQS_SERVICE_PORT=8003
NGINX_PORT=8080

# Frontend API base URL (served via nginx)
VITE_API_BASE_URL=/

# Google Sheets sync
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
CELERY_TIMEZONE=Asia/Bangkok

# CORS and app behavior
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
